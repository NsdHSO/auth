# --- Application Configuration ---
DOPPLER_TOKEN=dp.st.dev.your_token_here
DOPPLER_ENV=dev
HOST=127.0.0.1
PORT=4100
PORT_HOST=http://localhost:4100
APP_ENV=development
RUST_LOG=debug

# --- Database Configuration ---
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/your_db_name
PROD_DATABASE_URL=postgresql://user:password@prod-host:5432/prod_db_name

SCHEMA_SYNCHRONIZE=true
SYNCHRONIZE=true
AUTO_MIGRATE=true

# --- JWT Auth Configuration ---
# Use Base64 encoded RSA Private/Public keys
ACCESS_TOKEN_PRIVATE_KEY="your_base64_encoded_private_key"
ACCESS_TOKEN_PUBLIC_KEY="your_base64_encoded_public_key"

# Token Lifespan (Strings: e.g., "15m", "1h", "7d")
ACCESS_TOKEN_EXPIRED_IN=15m
REFRESH_TOKEN_EXPIRED_IN=7d

# Max Age in seconds (e.g., 900 for 15 minutes)
ACCESS_TOKEN_MAXAGE=900
REFRESH_TOKEN_MAXAGE=604800

# --- Email / SMTP Configuration ---
SMTP_TRANSPORT=smtp.gmail.com
SMTP_PASSWORD="your_app_specific_password"
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD="your_email_password"